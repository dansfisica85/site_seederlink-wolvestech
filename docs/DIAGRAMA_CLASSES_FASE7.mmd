%% Diagrama de classes — SeederLink Fase 7
%% Gerado a partir de src/domain/portfolio.js
%% Referência Mermaid: https://mermaid.js.org/syntax/classDiagram.html

classDiagram
    direction LR

    class PortfolioError {
        +String name
        +PortfolioError(String message)
    }

    class Localizacao {
        +Number latitude
        +Number longitude
        +Localizacao({latitude, longitude})
        +toJSON() Object
    }

    class AnaliseClimatica {
        +Number latitude
        +Number longitude
        +String consultedAt
        +String timezone
        +Object requestedPeriod
        +Object current
        +Object historical
        +Object assessment
        +AnaliseClimatica(Object result, String consultedAt)
        +toJSON() Object
        <<immutable>>
    }

    class PropriedadeRural {
        +String id
        +String nome
        +String cultura
        +Number areaHectares
        +Localizacao localizacao
        +AnaliseClimatica[] analises
        +PropriedadeRural({id, nome, cultura, areaHectares, localizacao, analises})
        +adicionarAnalise(AnaliseClimatica) PropriedadeRural
        +resumo() AnaliseClimatica
        +toJSON() Object
        <<immutable>>
    }

    class CarteiraPropriedades {
        +PropriedadeRural[] propriedades
        +CarteiraPropriedades(PropriedadeRural[] propriedades)
        +adicionar(PropriedadeRural) CarteiraPropriedades
        +remover(String id) CarteiraPropriedades
        +buscar(String id) PropriedadeRural
        +comparar(String id1, String id2) Object
        +toJSON() Object
        +~fromJSON(Object) CarteiraPropriedades
        <<immutable>>
    }

    class RepositorioLocal {
        +Storage storage
        +String key
        +RepositorioLocal(Storage storage, String key)
        +carregar() CarteiraPropriedades
        +salvar(CarteiraPropriedades) CarteiraPropriedades
    }

    %% Relacionamentos
    PropriedadeRural "1" *-- "1" Localizacao : contém
    PropriedadeRural "1" o-- "0..5" AnaliseClimatica : armazena
    CarteiraPropriedades "1" *-- "0..10" PropriedadeRural : gerencia
    AnaliseClimatica --> Localizacao : valida
    RepositorioLocal --> CarteiraPropriedades : persiste
    PortfolioError <|-- Error : estende
